# ==========================================
# AI Gmail Copilot - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------
# Google OAuth 2.0 Credentials (for Stage 2)
# ------------------------------------------
# Obtain from Google Cloud Console:
# 1. Create a Project in Google Cloud Console (https://console.cloud.google.com/)
# 2. Enable Gmail API under APIs & Services > Library
# 3. Configure OAuth Consent Screen (External or Internal)
# 4. Add Scopes:
#    - https://www.googleapis.com/auth/gmail.readonly
#    - https://www.googleapis.com/auth/gmail.modify
#    - https://www.googleapis.com/auth/gmail.compose
#    - https://www.googleapis.com/auth/gmail.send
# 5. Create OAuth Client ID (Web Application)
#    - Authorized Redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ------------------------------------------
# LLM API Configuration (for Stage 3)
# ------------------------------------------
# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Model selection (e.g. gemini-1.5-flash, gemini-1.5-pro, or gemini-2.0-flash)
LLM_MODEL=gemini-1.5-flash

# JWT / Session Secret for token encryption
SESSION_SECRET=a_random_secure_32_character_string_here
