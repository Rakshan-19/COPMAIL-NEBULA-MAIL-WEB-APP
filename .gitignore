# ==========================================
# Copmail - Git Ignore Rules
# ==========================================

# Environment variables & Sensitive Credentials (NEVER COMMIT)
.env
.env.local
.env.*.local
*.env
.tokens.json
*.tokens.json
**/.tokens.json
credentials*.json
**/credentials*.json
token.json
**/token.json
service-account*.json

# Node.js dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs & caches
dist/
**/dist/
build/
**/build/
.cache/
*.tsbuildinfo
.eslintcache

# Archives & Temporary exports
*.zip
*.tar.gz
*.tgz

# OS & IDE configurations
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.swp
*.swo
